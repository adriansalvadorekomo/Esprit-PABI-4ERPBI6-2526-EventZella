{
  "name": "EventZella Price Prediction Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Price Schedule",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/lab/train/price",
        "options": {}
      },
      "name": "Train Price Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.price,\n    f.budget,\n    f.marketing_spend,\n    f.new_beneficiaries,\n    f.reservations,\n    e.type::text as type,\n    r.status::text as status,\n\n    COUNT(f.event_sk) OVER (PARTITION BY f.sk_beneficiary) as nb_events,\n    AVG(f.final_price) OVER (PARTITION BY f.sk_beneficiary) as avg_spent_user\n\nFROM fact_suivi_event f\nLEFT JOIN dim_event e ON f.event_sk = e.event_sk\nLEFT JOIN dim_reservation r ON f.reservation_sk = r.reservation_sk\n\nORDER BY e.event_date DESC\n  LIMIT 1;",
        "options": {}
      },
      "name": "Fetch Latest Event Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        500
      ],
      "credentials": {
        "postgres": {
          "id": "GuXQ4ZWVBc0pJBzP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/predict/price",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"price\": {{$json[\"price\"]}},\n  \"budget\": {{$json[\"budget\"]}},\n  \"marketing_spend\": {{$json[\"marketing_spend\"]}},\n  \"new_beneficiaries\": {{$json[\"new_beneficiaries\"]}},\n  \"reservations\": {{$json[\"reservations\"]}},\n  \"nb_events\": {{$json[\"nb_events\"]}},\n  \"avg_spent_user\": {{$json[\"avg_spent_user\"]}},\n  \"type\": \"{{$json[\"type\"]}}\",\n  \"status\": \"{{$json[\"status\"]}}\"\n}",
        "options": {}
      },
      "name": "Predict Price API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        700
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list",
          "cachedResultName": "public"
        },
        "table": {
          "__rl": true,
          "value": "predictions",
          "mode": "list",
          "cachedResultName": "predictions"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
