    {
      "parameters": {
        "resource": "message",
        "subject": "=Erreur Training ML - {{ $now.format('dd/MM/yyyy HH:mm') }}",
        "emailType": "html",
        "html": "=<html>\n  <body style=\"margin:0; padding:0; background:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#182230;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7fb; padding:28px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"680\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:680px; max-width:94%; background:#ffffff; border:1px solid #d9e2ec; border-radius:8px; overflow:hidden;\">\n            <tr>\n              <td style=\"background:#b42318; padding:28px 32px; color:#ffffff;\">\n                <div style=\"font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#fecaca; font-weight:700;\">EventZella Pipeline Alert</div>\n                <h1 style=\"margin:10px 0 6px; font-size:24px; line-height:1.25; font-weight:700;\">Training Failed</h1>\n                <div style=\"font-size:14px; color:#fecaca;\">{{ $now.format('dd/MM/yyyy HH:mm') }}</div>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:28px 32px 12px;\">\n                <p style=\"margin:0 0 18px; font-size:15px; line-height:1.6; color:#344054;\">The price prediction model training pipeline encountered an error.</p>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fef2f2; border:1px solid #fecaca; border-radius:8px; margin:0 0 22px;\">\n                  <tr>\n                    <td style=\"padding:16px 18px;\">\n                      <div style=\"font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:#b42318; font-weight:700; margin-bottom:8px;\">Error Details</div>\n                      <div style=\"font-size:13px; line-height:1.7; color:#912018; font-family:Consolas, monospace;\">Erreur : {{$json[\"error\"]}}<br><br>Output : {{$json[\"output\"]}}</div>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:12px 32px 30px;\">\n                <div style=\"text-align:center; margin-top:16px;\">\n                  <a href=\"http://localhost:5678\" style=\"display:inline-block; background:#175cd3; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-size:14px; font-weight:700;\">Open n8n Dashboard</a>\n                </div>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"background:#f8fafc; border-top:1px solid #d9e2ec; padding:16px 32px; font-size:12px; line-height:1.5; color:#667085; text-align:center;\">Automatic alert from EventZella Price Prediction Pipeline.</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>",
        "toList": [
          "larrymclarens@gmail.com"
        ]
      },
      "name": "Send Training Failure Email",
