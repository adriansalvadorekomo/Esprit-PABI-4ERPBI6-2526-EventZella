            { "name": "budget", "value": "={{ $json.budget ?? 0 }}" },
            { "name": "final_price", "value": "={{ $json.final_price ?? 0 }}" },
            { "name": "rating", "value": "={{ $json.rating ?? 0 }}" },
            { "name": "visitors", "value": "={{ $json.visitors ?? 0 }}" },
            { "name": "marketing_spend", "value": "={{ $json.marketing_spend ?? 0 }}" },
            { "name": "price_budget_ratio", "value": "={{ $json.price_budget_ratio ?? 0 }}" },
            { "name": "margin", "value": "={{ $json.margin ?? 0 }}" },
            { "name": "has_complaint", "value": "={{ $json.has_complaint ?? 0 }}" },
            { "name": "type_encoded", "value": "={{ $json.type_encoded ?? 0 }}" },
            { "name": "season_encoded", "value": "={{ $json.season_encoded ?? 0 }}" },
            { "name": "is_weekend", "value": "={{ $json.is_weekend ?? 0 }}" },
            { "name": "month", "value": "={{ $json.month ?? 1 }}" }
          ]
        },
        "options": {}
      },
      "name": "Predict Loyalty API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 900]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst previousItem = $(\"Prepare Features for ML\").first().json;\nreturn [{\n  json: {\n    sk_beneficiary: previousItem.sk_beneficiary,\n    label: response.label,\n    probabilite_fidelite: response.probabilite_fidelite,\n    action_recommandee: response.action_recommandee\n  }\n}];"
      },
