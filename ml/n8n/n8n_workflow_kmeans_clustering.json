    {
      "parameters": {
        "jsCode": "const items = [];\nconst allItems = $input.all();\n\nconst subjectCounts = {};\nlet totalSubjects = 0;\nfor (const item of allItems) {\n  const s = item.json.complaint_subject;\n  if (s) { subjectCounts[s] = (subjectCounts[s] || 0) + 1; totalSubjects++; }\n}\n\nfor (const item of allItems) {\n  const d = item.json;\n  const eventType = d.event_type || '';\n  const resStatus = (d.reservation_status || '').toLowerCase().trim();\n  const subject = d.complaint_subject;\n  const subjectFreq = subject ? (subjectCounts[subject] || 0) / Math.max(totalSubjects, 1) : 0;\n\n  items.push({\n    json: {\n      budget: Number(d.budget) || 0,\n      price: Number(d.price) || 0,\n      final_price: Number(d.final_price) || 0,\n      rating: Number(d.rating) || 0,\n      visitors: Number(d.visitors) || 0,\n      complaint_status_bin: d.complaint_status ? 1 : 0,\n      complaint_subject_freq: subjectFreq,\n      ['event_type_Corporate Event']: eventType === 'Corporate Event' ? 1 : 0,\n      ['event_type_Private Party']: eventType === 'Private Party' ? 1 : 0,\n      ['event_type_Wedding']: eventType === 'Wedding' ? 1 : 0,\n      reservation_status_cancelled: resStatus === 'cancelled' ? 1 : 0,\n      reservation_status_confirmed: resStatus === 'confirmed' ? 1 : 0,\n      reservation_status_pending: resStatus === 'pending' ? 1 : 0\n    }\n  });\n}\nreturn items;"
      },
