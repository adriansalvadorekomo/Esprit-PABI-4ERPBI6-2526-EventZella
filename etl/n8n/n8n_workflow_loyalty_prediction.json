{
  "name": "EventZella Loyalty Prediction Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "name": "Loyalty Schedule",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/lab/train/loyalty",
        "options": {}
      },
      "name": "Train Loyalty Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.sk_beneficiary,\n    f.price,\n    f.budget,\n    f.final_price,\n    f.rating,\n    f.visitors,\n    f.marketing_spend,\n    f.id_complaint,\n    e.type,\n    e.event_date\nFROM fact_suivi_event f\nLEFT JOIN dim_event e ON f.event_sk = e.event_sk",
        "options": {}
      },
      "name": "Load Beneficiary Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        500
      ],
      "credentials": {
        "postgres": {
          "id": "GuXQ4ZWVBc0pJBzP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const price = item.json.price || 0;\n  const budget = item.json.budget || 0;\n  const final_price = item.json.final_price || 0;\n\n  items.push({\n    json: {\n      price: price,\n      budget: budget,\n      final_price: final_price,\n      rating: item.json.rating || 0,\n      visitors: item.json.visitors || 0,\n      marketing_spend: item.json.marketing_spend || 0,\n      price_budget_ratio: price / (budget + 0.01),\n      margin: final_price - price,\n      has_complaint: item.json.id_complaint ? 1 : 0,\n      type_encoded: 0,\n      season_encoded: 0,\n      is_weekend: 0,\n      month: new Date(item.json.event_date).getMonth() + 1,\n      sk_beneficiary: item.json.sk_beneficiary\n    }\n  });\n}\n\nreturn items;"
      },
      "name": "Prepare Features for ML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/predict/fidelisation",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "price",
              "value": "={{ $json.price ?? 0 }}"
            },
            {
              "name": "budget",
              "value": "={{ $json.budget ?? 0 }}"
            },
            {
              "name": "final_price",
              "value": "={{ $json.final_price ?? 0 }}"
            },
            {
              "name": "rating",
              "value": "={{ $json.rating ?? 0 }}"
            },
            {
              "name": "visitors",
              "value": "={{ $json.visitors ?? 0 }}"
            },
            {
              "name": "marketing_spend",
              "value": "={{ $json.marketing_spend ?? 0 }}"
            },
            {
              "name": "price_budget_ratio",
              "value": "={{ $json.price_budget_ratio ?? 0 }}"
            },
            {
              "name": "margin",
              "value": "={{ $json.margin ?? 0 }}"
            },
            {
              "name": "has_complaint",
              "value": "={{ $json.has_complaint ?? 0 }}"
            },
            {
              "name": "type_encoded",
              "value": "={{ $json.type_encoded ?? 0 }}"
            },
            {
              "name": "season_encoded",
              "value": "={{ $json.season_encoded ?? 0 }}"
            },
            {
              "name": "is_weekend",
              "value": "={{ $json.is_weekend ?? 0 }}"
            },
            {
              "name": "month",
              "value": "={{ $json.month ?? 1 }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Predict Loyalty API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst previousItem = $(\"Prepare Features for ML\").first().json;\nreturn [{\n  json: {\n    sk_beneficiary: previousItem.sk_beneficiary,\n    label: response.label,\n    probabilite_fidelite: response.probabilite_fidelite,\n    action_recommandee: response.action_recommandee\n  }\n}];"
      },
      "name": "Transform Prediction Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        1100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "675fbdc3-3d5e-434b-a725-33b0b3aa6afe",
              "name": "sk_beneficiary",
              "value": "={{ $json.sk_beneficiary }}",
              "type": "string"
            },
            {
              "id": "8a488a12-a9de-4072-9f3e-77f0d23298ae",
              "name": "label",
              "value": "={{ $json.label }}",
              "type": "string"
            },
            {
              "id": "2694c24f-4ac6-4091-b4fa-1101eb87fa63",
              "name": "probabilite",
              "value": "={{ $json.probabilite_fidelite }}",
              "type": "string"
            },
            {
              "id": "fa0dab71-5c66-4b5e-b5e5-b18fe535a479",
              "name": "action",
              "value": "={{ $json.action_recommandee }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "name": "Format Data for Export",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        250,
        1300
