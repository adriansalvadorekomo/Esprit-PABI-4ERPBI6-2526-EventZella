    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "9b69d91c-be79-4a16-ae6b-3cef8d10a021",
              "leftValue": "={{ $json.label }}",
              "rightValue": "Fidele",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "name": "Check Loyalty Level",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        600,
