sform:uppercase; letter-spacing:.05em; padding:12px 14px; border-bottom:1px solid #d9e2ec;\">Probabilite</th>\n                    <th align=\"left\" style=\"background:#f8fafc; color:#475467; font-size:12px; text-transform:uppercase; letter-spacing:.05em; padding:12px 14px; border-bottom:1px solid #d9e2ec;\">Action Recommandee</th>\n                  </tr>\n                  {{ $json.data.map(item => `\n                  <tr>\n                    <td style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:14px; color:#182230; font-weight:700;\">#${item.sk_beneficiary}</td>\n                    <td align=\"center\" style=\"padding:14px; border-bottom:1px solid #edf2f7;\"><span style=\"display:inline-block; background:#ecfdf5; color:#067647; font-size:13px; font-weight:700; padding:4px 10px; border-radius:999px;\">${(item.probabilite_fidelite * 100).toFixed(1)}%</span></td>\n                    <td style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:13px; color:#475467;\">${item.action_recommandee}</td>\n                  </tr>\n                  `).join('') }}\n                </table>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:12px 32px 30px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc; border:1px solid #d9e2ec; border-radius:8px;\">\n                  <tr>\n                    <td style=\"padding:16px 18px;\">\n                      <div style=\"font-size:14px; font-weight:700; color:#182230; margin-bottom:8px;\">Synthese de la campagne</div>\n                      <div style=\"font-size:13px; line-height:1.7; color:#475467;\">\u2022 Modele : Regression Logistique (Random Forest)<br>\u2022 Beneficiaires fideles : {{ $json.data.length }}<br>\u2022 Seuil de fidelite : Retour dans les 6 mois<br>\u2022 Execute par le pipeline n8n EventZella</div>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"background:#f8fafc; border-top:1px solid #d9e2ec; padding:16px 32px; font-size:12px; line-height:1.5; color:#667085; text-align:center;\">Notification automatique envoyee par le pipeline de fidelisation EventZella n8n.</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>",
        "toList": [
          "larrymclarens@gmail.com"
        ]
