    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n}\nconst items = [];\n\nfor (const item of $input.all()) {\n  const price = item.json.price || 0;\n  const budget = item.json.budget || 0;\n  const final_price = item.json.final_price || 0;\n  \n  items.push({\n    json: {\n      price: price,\n      budget: budget,\n      final_price: final_price,\n      rating: item.json.rating || 0,\n      visitors: item.json.visitors || 0,\n      marketing_spend: item.json.marketing_spend || 0,\n      price_budget_ratio: price / (budget + 0.01),\n      margin: final_price - price,\n      has_complaint: item.json.id_complaint ? 1 : 0,\n      type_encoded: 0,\n      season_encoded: 0,\n      is_weekend: 0,\n      month: new Date(item.json.event_date).getMonth() + 1,\n      sk_beneficiary: item.json.sk_beneficiary\n    }\n  });\n}\n\nreturn items;\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
