    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.price,\n    f.budget,\n    f.marketing_spend,\n    f.new_beneficiaries,\n    f.reservations,\n    e.type::text as type,\n    r.status::text as status,\n\n    COUNT(f.event_sk) OVER (PARTITION BY f.sk_beneficiary) as nb_events,\n    AVG(f.final_price) OVER (PARTITION BY f.sk_beneficiary) as avg_spent_user\n\nFROM fact_suivi_event f\nLEFT JOIN dim_event e ON f.event_sk = e.event_sk\nLEFT JOIN dim_reservation r ON f.reservation_sk = r.reservation_sk\n\nORDER BY e.event_date DESC\n  LIMIT 1;",
        "options": {}
