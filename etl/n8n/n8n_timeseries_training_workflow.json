30; font-weight:700;\">SARIMA</td>\n                    <td align=\"right\" style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:14px; color:#182230; font-family:Consolas, monospace;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"sarima_mae\"].toFixed(2) }}</td>\n                    <td style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:13px; color:#475467;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"best_model\"] === \"sarima\" ? \"Recommended\" : \"Evaluated\" }}</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:14px; color:#182230; font-weight:700;\">Prophet</td>\n                    <td align=\"right\" style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:14px; color:#182230; font-family:Consolas, monospace;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"prophet_mae\"].toFixed(2) }}</td>\n                    <td style=\"padding:14px; border-bottom:1px solid #edf2f7; font-size:13px; color:#475467;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"best_model\"] === \"prophet\" ? \"Recommended\" : \"Evaluated\" }}</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:14px; font-size:14px; color:#182230; font-weight:700;\">LSTM Proxy</td>\n                    <td align=\"right\" style=\"padding:14px; font-size:14px; color:#182230; font-family:Consolas, monospace;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"lstm_mae\"].toFixed(2) }}</td>\n                    <td style=\"padding:14px; font-size:13px; color:#475467;\">{{ $node[\"Compare Models & Select Best\"].json[\"results\"][\"best_model\"] === \"lstm\" ? \"Recommended\" : \"Evaluated\" }}</td>\n                  </tr>\n                </table>\n                <div style=\"margin:18px 0 0; padding:14px 16px; background:#fff8e6; border:1px solid #f3d58a; b