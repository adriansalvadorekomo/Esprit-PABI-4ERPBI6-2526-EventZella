{
  "title": "ML Pipeline Health",
  "uid": "ml-pipeline-health",
  "tags": ["eventzilla", "machine-learning", "pipeline"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Train Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "targets": [{ "expr": "increase(http_requests_total{job='fastapi',path=~'/train/.*|/predict/.*'}[24h])", "legendFormat": "Requests" }]
    },
    {
      "title": "Prediction Latency (p99)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] }, "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job='fastapi',path=~'/predict/.*'}[5m])) by (le))", "legendFormat": "p99" }]
    },
    {
      "title": "Pipeline Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='fastapi',status=~'5..'}[5m])) > 0", "legendFormat": "Errors" }]
    },
    {
      "title": "ML Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job='fastapi',path=~'/predict/.*'}[1m])) by (path)", "legendFormat": "{{path}}" },
        { "expr": "sum(rate(http_requests_total{job='fastapi',path=~'/train/.*'}[1m])) by (path)", "legendFormat": "{{path}}" }
      ]
    },
    {
      "title": "Recent Predictions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='fastapi',path=~'/predict/.*'}[1m]))", "legendFormat": "Predictions" }]
    },
    {
      "title": "Recent Training Runs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='fastapi',path=~'/train/.*'}[1m]))", "legendFormat": "Training" }]
    }
  ],
  "schemaVersion": 39
}
